if BOARD_AM62L_EVM

config AM62L_EVM_IO_EXPANDER
	bool "Enable I/O expander functionality"
	default n
	select I2C
	select GPIO
	select GPIO_HOGS
	help
	  Automatically configure GPIOs to enable I/O expander functionality.

	  This enables:
	  - Main GPIO0.89 (GPIO_SOC_VOUT0_FET_SEL0_PIN)
	  - TCA6424 GPIO.1 (VOUT0_FET_SEL0)

endif # BOARD_AM62L_EVM
